# Copy to .env and fill in real values. Never commit .env.
POSTGRES_PASSWORD=change-me
JWT_SECRET=change-me-long-random
ADMIN_EMAIL=admin@trello.local
ADMIN_PASSWORD=change-me
# Site origin as seen by browsers (Dev VPS: http://<ip>, Prod: https://<domain>)
CORS_ORIGIN=http://localhost
# production | development (Dev VPS uses development for debug logs + non-secure cookie over HTTP)
NODE_ENV=production
HTTP_PORT=80
# Paths to sibling repo checkouts (default: ../Trello-Clone-Backend, ../Trello-Clone-Frontend)
#BACKEND_DIR=
#FRONTEND_DIR=
